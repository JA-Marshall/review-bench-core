diff --git a/ledger/money.py b/ledger/money.py
index 8642c9c..73ce4a6 100644
--- a/ledger/money.py
+++ b/ledger/money.py
@@ -12,3 +12,11 @@ def line_total(unit_price, quantity):
     if quantity < 0:
         raise ValueError("quantity must not be negative")
     return to_pennies(Decimal(unit_price) * quantity)
+
+
+def apply_discount(total, percent):
+    """Reduce a line total by a whole-number percentage, rounded to the penny."""
+    if not 0 <= percent <= 100:
+        raise ValueError("percent must be between 0 and 100")
+    factor = (Decimal(100) - Decimal(percent)) / Decimal(100)
+    return round(float(total) * float(factor), 2)
